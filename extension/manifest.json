{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "icons": { "16": "icons/icon-192.png", "48": "icons/icon-192.png", "128": "icons/icon-192.png" },
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.messenger.com/*",
    "*://web.whatsapp.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://study-plan-demo.onrender.com/p/*",
        "http://localhost/p/*",
        "http://127.0.0.1/p/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}
