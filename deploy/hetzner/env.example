# The pilot's settings (docs/HETZNER.md, step 6). On the server:
#   cp deploy/hetzner/env.example deploy/hetzner/.env && nano deploy/hetzner/.env
# .env is never committed (.gitignore). Change a value, then:
#   docker compose -f deploy/hetzner/compose.yaml up -d
# Empty values are allowed; the app then leaves that part out.

# The domain the app answers on, without https:// (for example plan.example.com).
# Its DNS record must point at the server before the first start: Caddy asks Let's
# Encrypt for a certificate for it straight away. Passkeys belong to this name: a
# new domain later means students add their passkey again.
CPS_DOMAIN=

# The e-mail address students can write to about their data (the privacy page).
CPS_CONTACT=
# Who runs the service and answers for the data (GDPR): your name.
CPS_CONTROLLER=
# Who hosts it, and where, as the privacy page says it.
CPS_HOST=Hetzner Online GmbH (Germany, EU)

# Your review page, at /admin/<this>: 24 random characters or more. Make one with
#   openssl rand -base64 24 | tr -d '/+='
# and never paste it in a chat or an issue.
CPS_ADMIN_TOKEN=

# Optional: AI (DECISIONS.md D12). Empty, the rules answer.
ANTHROPIC_API_KEY=
# Dollars a month for AI, all students together.
CPS_AI_MONTHLY_CAP_USD=10

# Accounts (DECISIONS.md D94): students make one with their e-mail and a password
# before their plan. "off" keeps plans opened by their address alone (D35).
CPS_ACCOUNTS=on
# E-mail, only for the links that confirm an address and choose a new password.
# Any SMTP service works: a transactional one, or your university's. Empty, nothing
# is sent; the app says so, and you make a reset link for a student yourself on
# /admin/<CPS_ADMIN_TOKEN>/inbox.
CPS_SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS from the start).
CPS_SMTP_PORT=587
CPS_SMTP_USER=
CPS_SMTP_PASSWORD=
# The sender, for example: Study plan <plan@your-domain.eu> (an address the SMTP
# service lets you send from).
CPS_MAIL_FROM=
# Who delivers the e-mail, as the privacy page names it (the company and its country).
CPS_MAIL_PROVIDER=
